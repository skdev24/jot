{
  "name": "jot-editor",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --minify --outfile=../Jot/Editor/Web/editor.js && cp src/index.html ../Jot/Editor/Web/index.html",
    "test": "node --test test/*.test.js",
    "dev": "cp src/index.html ../Jot/Editor/Web/index.html && esbuild src/main.js --bundle --format=iife --outfile=../Jot/Editor/Web/editor.js --watch"
  },
  "license": "MIT",
  "description": "The TipTap editor that runs inside Jot's notch island",
  "dependencies": {
    "@floating-ui/dom": "^1.7.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-details": "3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "chrono-node": "2.10.2",
    "lowlight": "3.3.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.5"
  },
  "private": true,
  "type": "module"
}
